{
  "name": "orc-inversiones-peru",
  "compatibility_date": "2026-02-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Configuración para SPA (Single Page Application)
  // Redirecciona todas las rutas al index.html para manejar el routing del lado del cliente
  "routes": [
    {
      "pattern": "/*",
      "custom_domain": false
    }
  ]
}
